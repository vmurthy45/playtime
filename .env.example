# Copy to .env (gitignored) and fill in. Never commit .env.
# npsso: log in to PlayStation in a browser, then open
#   https://ca.account.sony.com/api/v1/ssocookie
# and copy the 64-char value. Lasts ~60 days.
PSN_NPSSO=

# Steam Web API key: https://steamcommunity.com/dev/apikey
# SteamID64 (17 digits): https://steamid.io/
# Profile > Privacy Settings > "Game details" must be Public.
STEAM_API_KEY=
STEAM_ID=
